{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/victorlazari/lzr1-skills/main/skills/security-review/templates/finding.schema.json",
  "title": "Security review report",
  "description": "Canonical machine-readable contract for an evidence-backed security review. Schema validity does not prove that a finding is correct.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "review",
    "findings",
    "conflicts",
    "unknowns"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "review": {
      "$ref": "#/$defs/review"
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/finding"
      }
    },
    "conflicts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/conflict"
      }
    },
    "unknowns": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/unknown"
      }
    }
  },
  "$defs": {
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "target_revision",
        "generated_at",
        "authorization",
        "scope",
        "coverage",
        "source_freshness"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^REV-[A-Z0-9][A-Z0-9._-]{2,63}$"
        },
        "target_revision": {
          "$ref": "#/$defs/non_empty_string"
        },
        "generated_at": {
          "$ref": "#/$defs/timestamp"
        },
        "authorization": {
          "type": "object",
          "additionalProperties": false,
          "required": ["owner_or_authorizer", "allowed_actions", "environment"],
          "properties": {
            "owner_or_authorizer": {
              "$ref": "#/$defs/non_empty_string"
            },
            "allowed_actions": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "enum": ["read", "local-static-analysis", "local-test", "write", "publish"]
              }
            },
            "environment": {
              "enum": ["local", "ci", "development", "staging", "production", "offline", "unknown"]
            },
            "constraints": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/non_empty_string"
              }
            }
          }
        },
        "scope": {
          "type": "object",
          "additionalProperties": false,
          "required": ["included", "excluded"],
          "properties": {
            "included": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/non_empty_string"
              }
            },
            "excluded": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["path_or_area", "reason"],
                "properties": {
                  "path_or_area": {
                    "$ref": "#/$defs/non_empty_string"
                  },
                  "reason": {
                    "$ref": "#/$defs/non_empty_string"
                  },
                  "approved_by": {
                    "type": ["string", "null"]
                  }
                }
              }
            }
          }
        },
        "coverage": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "reviewed",
            "mechanically_inventoried",
            "generated",
            "vendored",
            "binary_or_opaque",
            "inaccessible",
            "excluded",
            "not_applicable"
          ],
          "properties": {
            "reviewed": {"type": "integer", "minimum": 0},
            "mechanically_inventoried": {"type": "integer", "minimum": 0},
            "generated": {"type": "integer", "minimum": 0},
            "vendored": {"type": "integer", "minimum": 0},
            "binary_or_opaque": {"type": "integer", "minimum": 0},
            "inaccessible": {"type": "integer", "minimum": 0},
            "excluded": {"type": "integer", "minimum": 0},
            "not_applicable": {"type": "integer", "minimum": 0}
          }
        },
        "source_freshness": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["source", "retrieved_at", "url"],
            "properties": {
              "source": {
                "$ref": "#/$defs/non_empty_string"
              },
              "retrieved_at": {
                "$ref": "#/$defs/timestamp"
              },
              "url": {
                "type": "string",
                "format": "uri",
                "pattern": "^https://"
              }
            }
          }
        }
      }
    },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "properties": {
        "path": {
          "$ref": "#/$defs/non_empty_string"
        },
        "line_start": {
          "type": ["integer", "null"],
          "minimum": 1
        },
        "line_end": {
          "type": ["integer", "null"],
          "minimum": 1
        },
        "symbol": {
          "type": ["string", "null"]
        },
        "artifact_digest": {
          "type": ["string", "null"],
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "unavailable_reason": {
          "type": ["string", "null"]
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "summary", "redacted", "reference"],
      "properties": {
        "type": {
          "enum": [
            "code-excerpt",
            "configuration",
            "test-result",
            "artifact-digest",
            "runtime-observation",
            "advisory",
            "reasoning-only"
          ]
        },
        "summary": {
          "$ref": "#/$defs/non_empty_string"
        },
        "redacted": {
          "type": "boolean"
        },
        "reference": {
          "$ref": "#/$defs/non_empty_string"
        },
        "digest": {
          "type": ["string", "null"],
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      }
    },
    "reasoning": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "narrative", "steps"],
      "properties": {
        "model": {
          "enum": [
            "source-to-sink",
            "authorization-decision",
            "state-invariant",
            "trust-chain",
            "supply-chain",
            "configuration-exposure",
            "other"
          ]
        },
        "narrative": {
          "$ref": "#/$defs/non_empty_string"
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/non_empty_string"
          }
        }
      }
    },
    "confidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "rationale", "uncertainties"],
      "properties": {
        "level": {
          "enum": ["high", "medium", "low"]
        },
        "rationale": {
          "$ref": "#/$defs/non_empty_string"
        },
        "uncertainties": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/non_empty_string"
          }
        }
      }
    },
    "taxonomy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cwe"],
      "properties": {
        "cwe": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^CWE-[1-9][0-9]*$"
          }
        },
        "capec": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^CAPEC-[1-9][0-9]*$"
          }
        },
        "attack": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^T[0-9]{4}(?:\\.[0-9]{3})?$"
          }
        }
      }
    },
    "cvss_v4": {
      "type": "object",
      "additionalProperties": false,
      "required": ["vector", "metric_rationale"],
      "properties": {
        "vector": {
          "type": "string",
          "pattern": "^CVSS:4\\.0(?:/[A-Z]{1,3}:[A-Z0-9]+)+$"
        },
        "base_score": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 10
        },
        "metric_rationale": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "$ref": "#/$defs/non_empty_string"
          }
        }
      }
    },
    "live_context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "identifier", "status", "retrieved_at", "url"],
      "properties": {
        "source": {
          "enum": ["CISA-KEV", "EPSS", "CVE", "NVD", "vendor-advisory", "other"]
        },
        "identifier": {
          "$ref": "#/$defs/non_empty_string"
        },
        "status": {
          "$ref": "#/$defs/non_empty_string"
        },
        "retrieved_at": {
          "$ref": "#/$defs/timestamp"
        },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "status",
        "asset",
        "locations",
        "evidence",
        "reasoning",
        "preconditions",
        "impact",
        "taxonomy",
        "confidence",
        "remediation",
        "validation",
        "residual_risk",
        "conflicts"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^SR-[A-Z0-9][A-Z0-9._-]{2,63}$"
        },
        "title": {
          "$ref": "#/$defs/non_empty_string"
        },
        "status": {
          "enum": ["candidate", "confirmed", "disputed", "mitigated", "accepted-risk", "false-positive"]
        },
        "asset": {
          "$ref": "#/$defs/non_empty_string"
        },
        "locations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/location"
          }
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "reasoning": {
          "$ref": "#/$defs/reasoning"
        },
        "preconditions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/non_empty_string"
          }
        },
        "impact": {
          "type": "object",
          "additionalProperties": false,
          "required": ["dimensions", "narrative"],
          "properties": {
            "dimensions": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "enum": ["confidentiality", "integrity", "availability", "privacy", "financial", "safety", "supply-chain", "compliance-evidence"]
              }
            },
            "narrative": {
              "$ref": "#/$defs/non_empty_string"
            }
          }
        },
        "taxonomy": {
          "$ref": "#/$defs/taxonomy"
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        },
        "cvss_v4": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/cvss_v4"}
          ]
        },
        "live_context": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/live_context"
          }
        },
        "remediation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["recommendation", "alternatives", "compatibility", "rollout", "rollback"],
          "properties": {
            "recommendation": {"$ref": "#/$defs/non_empty_string"},
            "alternatives": {"type": "array", "items": {"$ref": "#/$defs/non_empty_string"}},
            "compatibility": {"$ref": "#/$defs/non_empty_string"},
            "rollout": {"$ref": "#/$defs/non_empty_string"},
            "rollback": {"$ref": "#/$defs/non_empty_string"}
          }
        },
        "validation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["method", "expected", "performed", "result", "evidence"],
          "properties": {
            "method": {"$ref": "#/$defs/non_empty_string"},
            "expected": {"$ref": "#/$defs/non_empty_string"},
            "performed": {"type": "boolean"},
            "result": {"enum": ["not-performed", "passed", "failed", "inconclusive"]},
            "evidence": {"type": "array", "items": {"$ref": "#/$defs/non_empty_string"}}
          }
        },
        "residual_risk": {
          "type": "object",
          "additionalProperties": false,
          "required": ["summary"],
          "properties": {
            "summary": {"$ref": "#/$defs/non_empty_string"},
            "owner": {"type": ["string", "null"]},
            "review_by": {"type": ["string", "null"], "format": "date"}
          }
        },
        "conflicts": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^CONFLICT-[A-Z0-9][A-Z0-9._-]{2,63}$"
          }
        },
        "accepted_risk": {
          "type": "object",
          "additionalProperties": false,
          "required": ["owner", "rationale", "compensating_controls", "review_by", "expires_at"],
          "properties": {
            "owner": {"$ref": "#/$defs/non_empty_string"},
            "rationale": {"$ref": "#/$defs/non_empty_string"},
            "compensating_controls": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/non_empty_string"}},
            "review_by": {"type": "string", "format": "date"},
            "expires_at": {"type": "string", "format": "date"}
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {"status": {"const": "accepted-risk"}},
            "required": ["status"]
          },
          "then": {
            "required": ["accepted_risk"]
          },
          "else": {
            "not": {
              "required": ["accepted_risk"]
            }
          }
        }
      ]
    },
    "conflict": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "finding_ids", "status", "positions"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^CONFLICT-[A-Z0-9][A-Z0-9._-]{2,63}$"
        },
        "finding_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^SR-[A-Z0-9][A-Z0-9._-]{2,63}$"
          }
        },
        "status": {
          "enum": ["open", "resolved"]
        },
        "positions": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/non_empty_string"
          }
        },
        "resolution": {
          "type": ["string", "null"]
        }
      }
    },
    "unknown": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description", "potential_impact", "owner"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^UNKNOWN-[A-Z0-9][A-Z0-9._-]{2,63}$"
        },
        "description": {
          "$ref": "#/$defs/non_empty_string"
        },
        "potential_impact": {
          "$ref": "#/$defs/non_empty_string"
        },
        "owner": {
          "type": ["string", "null"]
        }
      }
    }
  }
}
