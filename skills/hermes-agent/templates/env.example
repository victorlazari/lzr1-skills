# Hermes Agent environment example
# Verified against first-party documentation on 2026-08-08.
# Copy only the variables required by the reviewed deployment. Confirm every name
# in the installed release; unsupported variables may be ignored, so verify the
# effective runtime state and fail closed when a control cannot be demonstrated.
# Keep the actual .env owner-readable only, never commit it, and rotate any exposed
# credential.

# Never enable unrestricted/Yolo execution for shared, production, or
# untrusted-input use. Approval controls remain defense in depth, not isolation.
HERMES_YOLO_MODE=false

# The API server is disabled by default. If enabled after an exposure review,
# use a unique high-entropy secret and keep the listener behind the approved
# loopback/TLS/authentication/network perimeter.
API_SERVER_ENABLED=false
API_SERVER_KEY=REPLACE_WITH_UNIQUE_HIGH_ENTROPY_SECRET

# Leave browser CORS disabled unless a reviewed browser origin must call Hermes
# directly. If required, use exact HTTPS origins rather than a wildcard.
# API_SERVER_CORS_ORIGINS=https://REPLACE_WITH_APPROVED_ORIGIN

# Add exactly one or more approved provider credentials as required. These are
# placeholders, not working tokens. Confirm scope, endpoint, region, retention,
# rotation, revocation, and billing before use.
# OPENROUTER_API_KEY=REPLACE_WITH_SCOPED_PROVIDER_SECRET
# ANTHROPIC_API_KEY=REPLACE_WITH_SCOPED_PROVIDER_SECRET
# OPENAI_API_KEY=REPLACE_WITH_SCOPED_PROVIDER_SECRET
# GOOGLE_API_KEY=REPLACE_WITH_SCOPED_PROVIDER_SECRET

# Add platform, integration, memory-provider, or sandbox credentials only after
# the corresponding authorization and data-flow review. Do not forward this
# whole environment into terminal, code-execution, plugin, hook, or MCP paths.

# Deprecated: do not add HERMES_DASHBOARD_INSECURE. Current Hermes ignores it.
